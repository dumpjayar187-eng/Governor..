KICK_LIMIT = 3

# Time window for anti-nuke / mass moderation
ACTION_WINDOW = 10

# Anti-raid settings
RAID_JOIN_LIMIT = 8
RAID_TIME_WINDOW = 10
RAID_MODE_DURATION = 60

# How long to remember whitelist entries
# (Whitelist itself is permanent until removed)


