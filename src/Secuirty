# ============================================================
# ANTI-BOT ADD
# ============================================================

@bot.event
async def on_member_join(member):

    guild = member.guild

    # Track joins for Anti-Raid
    join_count = record_join(guild.id)

    # --------------------------------------------------------
    # RAID DETECTION
    # --------------------------------------------------------

    if join_count >= RAID_JOIN_LIMIT:

        if not raid_mode.get(guild.id, False):

            raid_mode[guild.id] = True

            await security_log(
                guild,
                "🚨 RAID DETECTED",
                f"**{join_count} members** joined within "
                f"{RAID_TIME_WINDOW} seconds.\n\n"
                f"Raid mode enabled for "
                f"{RAID_MODE_DURATION} seconds.",
                discord.Color.dark_red()
            )

            asyncio.create_task(
                disable_raid_mode_later(guild)
            )

    # --------------------------------------------------------
    # BOT DETECTION
    # --------------------------------------------------------

    if member.bot:

        await asyncio.sleep(1)

        executor = await get_audit_executor(
            guild,
            discord.AuditLogAction.bot_add,
            member.id
        )

        if executor:

            if not is_whitelisted(
                guild,
                executor.id
            ):

                await security_log(
                    guild,
                    "🤖 UNAUTHORIZED BOT",
                    f"**Bot:** {member.mention}\n"
                    f"**Added by:** {executor.mention}",
                    discord.Color.red()
                )

                # Remove unauthorized bot
                try:

                    await member.kick(
                        reason="Unauthorized bot added"
                    )

                except discord.Forbidden:
                    pass

                # Punish person who added it
                await punish_user(
                    guild,
                    executor.id,
                    "Unauthorized bot added"
                )

        return

    # --------------------------------------------------------
    # RAID MODE
    # --------------------------------------------------------

    if raid_mode.get(guild.id, False):

        if not is_whitelisted(
            guild,
            member.id
        ):

            try:

                await member.kick(
                    reason="Anti-Raid: raid mode active"
                )

                await security_log(
                    guild,
                    "🚨 RAID MEMBER REMOVED",
                    f"Removed **{member}** while raid mode was active.",
                    discord.Color.dark_red()
                )

            except discord.Forbidden:
                pass


# ============================================================
# RAID MODE TIMER
# ============================================================

async def disable_raid_mode_later(guild):

    await asyncio.sleep(RAID_MODE_DURATION)

    raid_mode[guild.id] = False

    recent_joins[guild.id].clear()

    await security_log(
        guild,
        "✅ RAID MODE DISABLED",
        "Raid mode has automatically ended.",
        discord.Color.green()
    )


