async def whitelist_add(ctx, member: discord.Member):

    whitelist[ctx.guild.id].add(member.id)

    await security_log(
        ctx.guild,
        "✅ USER WHITELISTED",
        f"{member.mention} was added to the security whitelist.",
        discord.Color.green()
    )

    await ctx.send(
        f"✅ {member.mention} has been whitelisted."
    )


# ============================================================
# WHITELIST REMOVE
# ============================================================

@whitelist_command.command(name="remove")
@commands.has_permissions(administrator=True)
async def whitelist_remove(ctx, member: discord.Member):

    whitelist[ctx.guild.id].discard(member.id)

    await ctx.send(
        f"✅ {member.mention} was removed from the whitelist."
    )


# ============================================================
# WHITELIST LIST
# ============================================================

@whitelist_command.command(name="list")
@commands.has_permissions(administrator=True)
async def whitelist_list(ctx):

    users = whitelist[ctx.guild.id]

    if not users:

        await ctx.send(
            "✅ The whitelist is empty."
        )

        return

    members = []

    for user_id in users:

        member = ctx.guild.get_member(user_id)

        if member:
            members.append(
                f"• {member.mention} (`{member.id}`)"
            )

    if not members:

        await ctx.send(
            "The whitelist contains no current members."
        )

        return

    await ctx.send(
        "### 🛡️ Whitelisted Users\n" +
        "\n".join(members)
    )


