# ============================================================
# DATA STORAGE
# ============================================================

# {
#   guild_id: {
#       user_id,
#   }
# }
whitelist = defaultdict(set)

# Security log channel
log_channels = {}

# Enabled / disabled security systems
security_enabled = defaultdict(lambda: True)

# Raid mode
raid_mode = {}

# Recent joins
recent_joins = defaultdict(deque)

# Action tracking
action_tracker = defaultdict(lambda: defaultdict(deque))


# ============================================================
# TIME HELPERS
# ============================================================

def now():
    return datetime.now(timezone.utc)


def cleanup_actions(queue, seconds):
    current = now()

    while queue:
        if (current - queue[0]).total_seconds() > seconds:
            queue.popleft()
        else:
            break


def record_action(guild_id, user_id, action):
    key = (guild_id, user_id, action)

    queue = action_tracker[key]

    cleanup_actions(queue, ACTION_WINDOW)

    queue.append(now())

    return len(queue)


def record_join(guild_id):
    queue = recent_joins[guild_id]

    cleanup_actions(queue, RAID_TIME_WINDOW)

    queue.append(now())

    return len(queue)


# ============================================================
# WHITELIST
# ============================================================

def is_whitelisted(guild, user_id):

    # Server owner is ALWAYS trusted
    if guild.owner_id == user_id:
        return True

    return user_id in whitelist[guild.id]


# ============================================================
# SECURITY LOGGING
# ============================================================

async def security_log(guild, title, description, color=discord.Color.red()):

    channel_id = log_channels.get(guild.id)

    if not channel_id:
        return

    channel = guild.get_channel(channel_id)

    if not channel:
        return

    embed = discord.Embed(
        title=f"🛡️ {title}",
        description=description,
        color=color,
        timestamp=now()
    )

    try:
        await channel.send(embed=embed)
    except discord.Forbidden:
        print(
            f"[ERROR] Cannot send security logs in {guild.name}"
        )
    except Exception as e:
        print(f"[ERROR] Logging failed: {e}")


# ============================================================
# FIND AUDIT LOG EXECUTOR
# ============================================================

async def get_audit_executor(
    guild,
    action,
    target_id=None
):

    try:

        async for entry in guild.audit_logs(
            limit=10,
            action=action
        ):

            # Ignore old audit entries
            if entry.created_at < now() - timedelta(seconds=10):
                continue

            if target_id is not None:

                if not entry.target:
                    continue

                if getattr(entry.target, "id", None) != target_id:
                    continue

            return entry.user

    except discord.Forbidden:

        await security_log(
            guild,
            "Missing Permission",
            "I cannot read the server Audit Log.",
            discord.Color.orange()
        )

    except Exception as e:

        print(f"[Audit Log Error] {e}")

    return None


# ============================================================
# PUNISH USER
# ============================================================

async def punish_user(
    guild,
    user_id,
    reason,
    ban=True
):

    member = guild.get_member(user_id)

    if not member:
        return False

    # Never punish owner
    if member.id == guild.owner_id:
        return False

    # Never punish whitelist
    if is_whitelisted(guild, member.id):
        return False

    try:

        if ban:

            await member.ban(
                reason=f"Anti-Nuke: {reason}",
                delete_message_seconds=0
            )

            await security_log(
                guild,
                "🚨 USER BANNED",
                f"**User:** {member.mention}\n"
                f"**Reason:** {reason}",
                discord.Color.red()
            )

        else:

            await member.kick(
                reason=f"Anti-Nuke: {reason}"
            )

            await security_log(
                guild,
                "⚠️ USER KICKED",
                f"**User:** {member.mention}\n"
                f"**Reason:** {reason}",
                discord.Color.orange()
            )

        return True

    except discord.Forbidden:

        await security_log(
            guild,
            "Permission Error",
            f"I couldn't punish **{member}**.\n"
            "Make sure my role is above their role.",
            discord.Color.orange()
        )

    except Exception as e:

        print(f"[Punishment Error] {e}")

    return False


