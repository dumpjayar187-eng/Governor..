# RAID ON
# ============================================================

@security.command()
@commands.has_permissions(administrator=True)
async def raid(ctx, state=None):

    if state is None:

        current = raid_mode.get(
            ctx.guild.id,
            False
        )

        await ctx.send(
            f"🚨 Raid mode is currently "
            f"`{'ON' if current else 'OFF'}`."
        )

        return

    state = state.lower()

    if state == "on":

        raid_mode[ctx.guild.id] = True

        await security_log(
            ctx.guild,
            "🚨 RAID MODE ENABLED",
            f"Raid mode manually enabled by {ctx.author.mention}.",
            discord.Color.dark_red()
        )

        await ctx.send(
            "🚨 **Raid mode enabled.**"
        )

    elif state == "off":

        raid_mode[ctx.guild.id] = False

        await security_log(
            ctx.guild,
            "✅ RAID MODE DISABLED",
            f"Raid mode manually disabled by {ctx.author.mention}.",
            discord.Color.green()
        )

        await ctx.send(
            "✅ **Raid mode disabled.**"
        )

    else:

        await ctx.send(
            f"Use `{PREFIX}security raid on` "
            f"or `{PREFIX}security raid off`."
        )


