@bot.event
async def on_guild_channel_delete(channel):

    guild = channel.guild

    await asyncio.sleep(1)

    executor = await get_audit_executor(
        guild,
        discord.AuditLogAction.channel_delete,
        channel.id
    )

    if not executor:
        return

    if is_whitelisted(
        guild,
        executor.id
    ):
        return

    count = record_action(
        guild.id,
        executor.id,
        "channel_delete"
    )

    await security_log(
        guild,
        "🗑️ CHANNEL DELETED",
        f"**Channel:** `{channel.name}`\n"
        f"**Executor:** {executor.mention}\n"
        f"**Count:** `{count}/{CHANNEL_DELETE_LIMIT}`",
        discord.Color.orange()
    )

    if count >= CHANNEL_DELETE_LIMIT:

        await punish_user(
            guild,
            executor.id,
            "Mass channel deletion"
        )


